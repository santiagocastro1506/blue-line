# The natural-language search compiles a phrase into a validated filter via
# strict-schema tool calling. Without a key the field stays honest about being
# unavailable; it never guesses.
ANTHROPIC_API_KEY=

# Optional. Unset, the app runs real PostGIS in-process via PGlite (WASM) and
# seeds itself from data/. Set it to a Postgres+PostGIS connection string
# (Supabase gives you one) and every spatial query runs there instead. The SQL
# is identical either way.
DATABASE_URL=
