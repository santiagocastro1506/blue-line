# ---------------------------------------------------------------- the model
# Powers one thing only: the natural-language field in the title block, which
# compiles a phrase into a validated filter object via strict-schema tool
# calling. The model never writes SQL and never sees the database. Without a
# key the field refuses honestly instead of guessing; everything else on the
# sheet — the map, drawing, WKT, and every PostGIS measurement — works without
# one.
#
# Set either key. Anthropic wins if both are present; LLM_PROVIDER overrides.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. "anthropic" or "gemini". Only needed to force one when both keys exist.
LLM_PROVIDER=

# Optional model overrides. Defaults: claude-sonnet-5 / gemini-2.5-flash
ANTHROPIC_MODEL=
GEMINI_MODEL=

# ------------------------------------------------------------- the database
# Optional. Unset, the app runs real PostGIS in-process via PGlite (WASM) and
# seeds itself from data/ — no external service, nothing to keep alive. Set it
# to a Postgres+PostGIS connection string (Supabase gives you one) and every
# spatial query runs there instead. The SQL is identical either way.
DATABASE_URL=
